{
    "swagger": "2.0",
    "info": {
        "description": "This is the command API for the Grupos service.",
        "title": "Grupos Command API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "url": "http://www.swagger.io/support",
            "email": "support@swagger.io"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/v1/grupos": {
            "post": {
                "description": "Creates a new group and publishes a GrupoCreado event.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "grupos"
                ],
                "summary": "Create a new group",
                "parameters": [
                    {
                        "description": "Group information",
                        "name": "grupo",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.CreateGrupoRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/domain.Event"
                        }
                    }
                }
            }
        },
        "/v1/grupos/{id}": {
            "put": {
                "description": "Updates a group's name and publishes a GrupoActualizado event.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "grupos"
                ],
                "summary": "Update a group's name",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Group ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Group new name",
                        "name": "grupo",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.UpdateGrupoRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/domain.Event"
                        }
                    }
                }
            }
        },
        "/v1/grupos/{id}/dirigentes": {
            "post": {
                "description": "Assigns a leader to a group and publishes a DirigenteAsignadoAGrupo event.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "grupos"
                ],
                "summary": "Assign a leader to a group",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Group ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Leader ID",
                        "name": "dirigente",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.AssignDirigenteRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/domain.Event"
                        }
                    }
                }
            }
        },
        "/v1/grupos/{id}/dirigentes/{dirigenteId}": {
            "delete": {
                "description": "Removes a leader from a group and publishes a DirigenteRemovidoDeGrupo event.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "grupos"
                ],
                "summary": "Remove a leader from a group",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Group ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Leader ID",
                        "name": "dirigenteId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/domain.Event"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Event": {
            "type": "object",
            "properties": {
                "header": {
                    "$ref": "#/definitions/domain.EventHeader"
                },
                "payload": {}
            }
        },
        "domain.EventHeader": {
            "type": "object",
            "properties": {
                "aggregateId": {
                    "type": "string"
                },
                "eventId": {
                    "type": "string"
                },
                "eventType": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "handler.AssignDirigenteRequest": {
            "type": "object",
            "required": [
                "dirigenteId"
            ],
            "properties": {
                "dirigenteId": {
                    "type": "string"
                }
            }
        },
        "handler.CreateGrupoRequest": {
            "type": "object",
            "required": [
                "fundacionFecha",
                "nombre"
            ],
            "properties": {
                "fundacionFecha": {
                    "type": "string"
                },
                "nombre": {
                    "type": "string"
                }
            }
        },
        "handler.UpdateGrupoRequest": {
            "type": "object",
            "required": [
                "nombre"
            ],
            "properties": {
                "nombre": {
                    "type": "string"
                }
            }
        }
    }
}